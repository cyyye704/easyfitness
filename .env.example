# 浏览器公开配置。两项都留空时使用本地模式；配置后启用邮箱登录与云端记录。
# 仅使用项目根 URL 和 sb_publishable_ 开头的新公开发布密钥。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 服务端 AI / COROS 登录验证配置。与上面指向同一 Supabase 项目、使用相同公开密钥。
# 缺失或不完整时 AI 返回 AUTH_NOT_CONFIGURED，不会跳过登录验证。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# AI 仍须通过登录验证；false 时禁用三个 AI 接口。
AI_FEATURE_ENABLED=true

# 仅服务端秘密密钥。禁止 VITE_ 前缀，禁止提交真实值。
DEEPSEEK_API_KEY=

# 可选，默认 deepseek-v4-flash。
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：COROS 官方 MCP。留空时显示未配置，不发起外部连接。
# 站点的唯一访问 origin，不带路径。开发示例：http://localhost:3000
COROS_APP_ORIGIN=
# 32 字节随机密钥的标准 base64（44 字符），只在服务端保存，用于加密授权 Cookie。
COROS_COOKIE_SECRET=
# 可选：已注册的 COROS 公有 OAuth 客户端 ID；留空则使用官方动态注册。
COROS_CLIENT_ID=

# 不需要也不要设置 Supabase service_role / sb_secret_ 或数据库密码。
